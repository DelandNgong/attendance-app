rules_version = '2';

// Data is split into `users` (basic, roster-visible: name, role, teamId) and
// `member_details` (sensitive: school/national ID, DOB, height, weight) —
// Firestore rules can't restrict access at the individual-field level, so
// this split is what makes it possible to let teammates see each other's
// names without also exposing everyone's ID numbers and date of birth.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCaptainOrCoach(teamId) {
      return isSignedIn()
        && userDoc().role in ['captain', 'coach']
        && userDoc().teamId == teamId;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.auth.uid == userId ||
        isCaptainOrCoach(request.resource.data.teamId)
      );
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role) ||
        isCaptainOrCoach(resource.data.teamId)
      );
    }

    // Sensitive fields only — readable/writable by the person themselves or
    // a captain/coach on their team. Never returned in the roster list, never
    // included in the CSV export.
    match /member_details/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId || isCaptainOrCoach(resource.data.teamId)
      );
      allow create: if isSignedIn() && (
        request.auth.uid == userId || isCaptainOrCoach(request.resource.data.teamId)
      );
      allow update: if isSignedIn() && (
        request.auth.uid == userId || isCaptainOrCoach(resource.data.teamId)
      );
      allow delete: if false;
    }

    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow write: if isCaptainOrCoach(teamId);

      match /meta/{docId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isCaptainOrCoach(request.resource.data.teamId);
      allow update, delete: if false;
    }

    match /attendance_records/{recordId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isCaptainOrCoach(resource.data.teamId));
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /verifications/{verificationId} {
      allow read: if isSignedIn();
      allow create: if isCaptainOrCoach(request.resource.data.teamId);
      allow update, delete: if false;
    }
  }
}
