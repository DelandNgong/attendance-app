rules_version = '2';

// Key design decision: attendance_records can be CREATED but never UPDATED
// or DELETED, enforced here at the database level. This means the
// append-only guarantee isn't just "the app doesn't have an edit button" —
// it's the database itself refusing to allow it, even if someone tried to
// edit a record directly through the Firebase console or API.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCaptainOrCoach(teamId) {
      return isSignedIn()
        && userDoc().role in ['captain', 'coach']
        && userDoc().teamId == teamId;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Users can update their own profile, but can't change their own role
      // (that has to be set by a captain/coach, handled separately).
      allow update: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;
    }

    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow write: if isCaptainOrCoach(teamId);

      match /meta/{docId} {
        allow read: if isSignedIn();
        // Written inside a transaction alongside attendance_records — kept
        // open to any signed-in user for now since the transaction logic
        // itself controls correctness; tighten further once roles settle.
        allow write: if isSignedIn();
      }
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isCaptainOrCoach(request.resource.data.teamId);
      allow update, delete: if false;
    }

    match /attendance_records/{recordId} {
      // A member can read their own records; captains/coaches can read
      // everyone's on their team (needed for the spot-check and export).
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isCaptainOrCoach(resource.data.teamId));

      // Anyone signed in can create a record, but only for themselves —
      // no marking someone else present.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      // Append-only: no edits, no deletes, for anyone, ever.
      allow update, delete: if false;
    }
  }
}
